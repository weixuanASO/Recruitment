# Copy this file to ".env" for local testing, and set the same
# values in Vercel (Project → Settings → Environment Variables) for production.
# Everything here is OPTIONAL — the form works without it (WhatsApp is primary).

# Google Sheet backup — an Apps Script web-app URL (see docs/BACKEND-SETUP.md)
SHEET_WEBHOOK_URL=

# Email copy of each application — from resend.com
RESEND_API_KEY=
NOTIFY_FROM="The Advisor Path <apply@theadvisorpath.org>"
NOTIFY_TO=your-email@example.com
